{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/makoydev/sg-pii-rules/schema/detectors.schema.json",
  "title": "sg-pii-rules detectors",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "detectors"],
  "properties": {
    "$schema": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "detectors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entity", "description", "pattern", "sources"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "entity": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "description": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "validator": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "sources": {
            "type": "array",
            "items": { "type": "string", "pattern": "^https://" }
          }
        }
      }
    }
  }
}
